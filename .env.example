# Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# Public application URL.
APP_URL="https://your-app.example"

# Generate a unique, high-entropy secret; do not use this placeholder.
JWT_SECRET="change-me"

# Optional for local development; required in production.
MONGO_URI=""

# Required for Vercel Blob uploads in production.
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Firebase Admin service-account JSON; required for Google sign-in in production.
FIREBASE_SERVICE_ACCOUNT='{"project_id":"your-project-id","client_email":"service-account@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
